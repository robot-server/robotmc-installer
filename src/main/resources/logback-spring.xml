<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Finder로 켜면 작업 디렉터리가 / 이다. logs/application.log 는 /logs 가 되어 시작이 실패한다. -->
    <property name="LOG_FILE" value="${user.home}/.robotmc-installer/logs/application.log"/>
    <property name="LOGBACK_ROLLINGPOLICY_MAX_HISTORY" value="30"/>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>
</configuration>
